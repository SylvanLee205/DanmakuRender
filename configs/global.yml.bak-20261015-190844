# ######################
# 此文件非必要不修改！
# ######################

# 第三方工具路径，设置为空将会自动选择
executable_tools_path: 
  ffmpeg: ~
  ffprobe: ~
  biliup: ~

# DMR引擎参数
dmr_engine_args: 
  # 选择组件
  enabled_plugins: ['downloader', 'render', 'uploader', 'cleaner']
  # 配置文件路径
  # 可设置为文件/文件夹列表
  config_path: ./configs
  # 是否动态更新配置文件（监控任务配置的新增/修改/删除并热加载）
  dynamic_config: True
# 默认下载参数
download_args:
  # 直播录制
  live:
    # 直播间链接
    # 请填写标准格式链接，例如：https://live.bilibili.com/123456
    url: 
    # 录制程序引擎，可选ffmpeg, streamgears, pyrequests 或者 streamlink
    # 在使用streamgears作为录制引擎时不支持录制B站hls流
    # 建议PC推流的直播使用ffmpeg录制，手机推流的直播使用streamgears录制
    # 录制twitch等特殊平台建议使用streamlink
    # streamlink可用平台请参考 https://streamlink.github.io/plugins.html
    # 默认为auto，由程序自动选择
    engine: auto
    # 录制输出文件夹，设置为空则使用主播名称作为文件夹
    output_dir: ./直播回放
    # 录制文件名称模板
    # 可使用关键字替换，默认效果：飞天狙想要努力变胖-2023年3月1日20点30分，注意这里不能含有冒号，斜杠等非法字符！！
    output_name: '{STREAMER.NAME}-{CTIME.YEAR}年{CTIME.MONTH:02d}月{CTIME.DAY:02d}日{CTIME.HOUR:02d}点{CTIME.MINUTE:02d}分'
    # 录播分段时间（秒），默认一个小时
    segment: 3600
    # 录制视频的格式，默认flv
    output_format: mkv
    # 是否录制弹幕
    danmaku: True
    # 是否录制直播流
    video: True
    # 延迟下播计时（分钟）
    # 使用这个功能可以把主播短暂下播又开播认定为同一场直播
    stop_wait_time: 120
    # 直播流选项
    # 使用streamlink录制时不生效
    stream_option:
      # 直播流CDN
      # 对于虎牙直播，此项可选al, tx, hw等cdn服务器的缩写
      # 对于B站，可选特定的CDN域名前缀，例如：c1--cn-gotcha208
      # 或者正则匹配特定CDN，例如：.*cn-gotcha.*
      # 默认为空，由程序随机选择可用cdn
      stream_cdn: ~
      # 直播流类型（暂时只对B站生效）可选flv，hls，avc，hevc，av1
      # 注意hls流无法使用streamgears录制
      # 如果需要同时指定codec类型，请使用'type-codec'的格式，例如：flv-avc
      # 默认为空，由程序自动选择
      stream_type: ~
      # B站观看cookies，用于获取直播流，如果不填写则使用登录B站上传视频的cookies
      # 如果希望不登录录制最低画质，请设置为'None'
      bili_watch_cookies: .login_info/bili_watch_cookies.json
      disable_lowspeed_interrupt: false      # streamlink 额外输入参数
      # 可用参数列表请参考 https://streamlink.github.io/cli.html
      # 一个典型的使用方法是添加一个--twitch-api-header参数，用于取消twitch直播流的广告
      # 特别提醒，使用此方法传入参数会在日志文件中明文显示，如果需要共享日志文件请确保删除了敏感信息！
      streamlink_extra_args: [
        "--twitch-disable-ads",     # 去广告，去掉、跳过嵌入的广告流
        "--twitch-disable-reruns",  # 如果该频道正在重放回放，不打开流
      ]

    # 以下是弹幕录制参数
    # 弹幕录制格式，只能选择ass
    dm_format: ass 
    # 弹幕上下间距（行距），设置为0-1的表示为视频宽度的倍数，设置为大于1的数表示像素，默认6
    margin_h: 2
    # 弹幕左右间距，设置为-1表示允许弹幕叠加，设置为0-1的表示间距为视频宽度的倍数，设置为大于1的数表示像素，默认0.05
    # 实际上这个东西就是弹幕密度，弹幕左右间距越大密度越小
    margin_w: 0.14
    # 指定弹幕占屏幕的最大比例（即屏幕上半部分有多少可以用来显示弹幕），默认为0.4
    dmrate: 0.2
    # 指定弹幕字体，默认为微软雅黑字体(Microsoft YaHei)
    #font: Microsoft YaHei
    font: Source Han Sans SC
    # 指定弹幕字体大小，默认为36
    fontsize: 30
    # Distance from Screen Top 弹幕距离屏幕顶端的距离（像素，例如20，表示距离屏幕顶端20px）
    dst: 12
    # 指定单条弹幕持续时间（秒），默认为16
    dmduration: 12
    # 指定弹幕不透明度，默认为0.8
    opacity: 0.84
    # 使用自适应弹幕大小（会让把设置的弹幕大小按1080P标准缩放）
    auto_fontsize: True
    # 弹幕描边颜色(6位十六进制)
    outlinecolor: 222222
    # 弹幕描边宽度
    outlinesize: 0.44
    # 弹幕流选项
    dm_stream_option:
      # 用于获取抖音弹幕流的cookies，用于特殊情况下录制抖音弹幕(https://github.com/SmallPeaches/DanmakuRender/issues/258)
      # 格式：'__ac_nonce=xxx; __ac_signature=xxx; sessionid=xxx'
      # 特别提醒，使用此方法传入参数会在日志文件中明文显示，如果需要共享日志文件请确保删除了敏感信息！
      # 推荐设置为cookies所在的json文件，这样cookies就不会明文显示，json文件应该为cookies字典：{'__ac_nonce': xxx, ...}
      #douyin_dm_cookies: .login_info/douyin_cookies.json
      douyin_dm_cookies: ~
    # 弹幕过滤规则，满足其中任意条件的弹幕将被过滤
    dm_filter:
      # 弹幕类型过滤，只获取指定类型的弹幕，支持情况请参考文档
      # 可选值：all（所有）, danmaku（纯弹幕）, gift（礼物信息）, entry（进场信息）, superchat（超级弹幕）
      #
      # ⚠️ 这里留空（~）等于只收 danmaku（纯文字弹幕）！
      #   代码位置 DMR/Downloader/Danmaku/danmaku.py:130
      #       dm_type = self.dm_filter.get('dm_type') or 'danmaku'
      #   所以 dm_type 为空时，礼物弹幕会在**进入 dm_template 之前**就被丢掉，
      #   下面 dm_template.gift 配得再好也不会生效。
      #
      # 当前设置：只收 纯弹幕 + 礼物，不要进场/超级弹幕（进场消息太多，会刷屏）
      dm_type: [danmaku, gift]
      # 关键字过滤，只要有关键字的弹幕都会被过滤
      # 例如：[菜, fw]
      keywords: ~
      # 用户名称过滤，只有用户名称完全与发弹幕的用户名相同才会过滤
      # 例如：[虎牙小助手, TwitchBot]
      username: ~
      # 最长弹幕长度，超过此长度的弹幕将被过滤，0表示不限制
      max_length: 0
    # 弹幕模板，具体使用请参考文档
    dm_template:
      # 不同类型弹幕的模板
      danmaku: '{UNAME}: {CONTENT}'
      superchat: ~
      gift: '{uname} 赠送给主播价值 {price} {price_unit} 的 {gift_count} 个 {gift_name}'
      entry: ~
    # 高级弹幕录制参数
    # 请确保你明白这些参数的含义后再修改
    advanced_dm_args:
      # 弹幕延迟补偿(秒)，将弹幕强行提前
      dm_delay_fixed: 6
      # 弹幕超时自动重启（秒），超过一段时间无弹幕会自动重启弹幕录制，0表示关闭
      dm_auto_restart: 600
      # 额外弹幕流输入
      # 部分主播可能同时在平台同时开播，可以用这个同时录制多个直播间的弹幕到一个视频
      # 应该设置为一个列表（不包括原来录制的房间），例如：['https://live.bilibili.com/123456', 'https://live.bilibili.com/654321']
      dm_extra_inputs: []
      # 弹幕文件最小录制时间（秒），小于此录制时间的弹幕文件将被删除
      # 此功能可用于删除因为录制错误导致的许多空弹幕文件
      dm_file_min_time: 30
  
  # 视频下载
  videos:
    # 需要下载的视频链接
    # 可以是UP主主页，播放列表，合集等
    url: 
    # 录制输出文件夹
    output_dir: ./视频下载
    # 录制文件名称格式
    # 默认为 视频标题.视频格式，例如：【2024LPL春季赛】2月7日 IG vs RNG.mp4
    # 如果下载B站用户主页视频（https://space.bilibili.com/<mid> 格式的链接），则可以使用关键字替换，例如 {STREAMER.NAME}-{TITLE}
    # 如果下载其他的B站视频，例如合集，播放列表等，则应该设置yutto的输出格式，例如 {title}/{name}
    # 具体请参考 https://github.com/yutto-dev/yutto?tab=readme-ov-file#已支持的下载类型
    # 如果使用yt-dlp下载其他平台的视频，应该使用yt-dlp的输出格式，例如 '%(title)s.%(ext)s'
    # 具体请参考 https://github.com/yt-dlp/yt-dlp?tab=readme-ov-file#output-template
    output_name: ~
    # 下载引擎
    # B站视频默认使用yutto，其他平台默认使用yt-dlp
    engine: ~
    # 视频质量，默认可用的最高画质
    # 此参数将被直接传入下载引擎，具体可用值请参考相关文档
    quality: ~
    # 登录账号名称，程序依靠这个来识别不同的账号
    # 下载B站时，不登录只能下载480P视频，登录但是不是大会员只能下1080P30的视频
    # 其他平台暂不生效
    account: bilibili
    # 登录cookies路径
    # 如果设置为空将会保存到./login_info/{ACCOUNT}.json
    cookies: ~
    # 下载视频的起始时间，设置格式为'YYYY-MM-DD HH:MM:SS'，例如'2024-01-01 00:00:00'
    # 如果设置为空将从当前时间开始下载之后的新视频
    # YouTube视频只能精确到天，例如设置为'2024-01-01 12:00:00'仍然会从0点开始下载
    start_time: ~
    # 下载视频的结束时间
    # 一般情况下应该设置为空
    end_time: ~
    # 是否下载弹幕
    # 仅对B站视频有效
    danmaku: False
    # 是否下载字幕
    # 仅对B站视频有效，如果yt-dlp需要字幕请在extra_args中添加相应参数
    subtitle: False
    # 检测更新时长（秒），默认600
    # 每隔这么长时间检测一次是否有新视频
    check_interval: 600
    # 下载超时时间（秒）
    # 如果一次下载超过此时间没有结束，将会被强制终止
    subprocess_timeout: 86400
    # 附加参数列表
    # 此参数将直接传入下载引擎，可以用来设置一些特殊的下载参数
    extra_args: []

  # 虚拟录制：把外部程序录好的文件"搬运"进来（不重新下载，只做处理/渲染/上传）
  # 详细用法见使用文档中的"虚拟录制"一节  virtual:
    # 监控文件夹
    input_dir: ~
    # 输出文件夹
    # 如果设置了输出文件夹，则视频会被复制到输出文件夹再处理
    output_dir: ~
    # 匹配视频文件的正则表达式
    # 默认匹配可用视频文件
    video_pattern: ~
    # 匹配视频文件名称中视频信息
    info_pattern:
      # 匹配主播名称，默认为任务名称
      name: ~
      # 匹配视频标题，默认为视频文件名称
      title: ~
      # 匹配视频时间，默认为视频文件的创建时间
      time_str: ~
      # 匹配视频时间字符串转换为datetime对象的格式，用于datetime.strptime
      # 必须与time_str同时使用
      time_format:
      # 是否匹配弹幕文件，仅支持同名的ass文件
      danmaku: True
    # 分段等待时间（分钟），如果视频在此时间内没有更新，则会被认为分段录制完成
    segment_wait_time: 3
    # 下播等待时间（分钟），如果没有视频在此时间内更新，则会被认为直播已经结束
    stop_wait_time: 10
    # 检测视频的起始时间，默认为当前时间
    start_time: ~
    # 高级视频参数
    advanced_video_args: 
      # 视频文件最小大小（MB），小于此大小的视频文件将会被忽略，默认1MB
      min_video_size: 1
      # 视频文件最小录制时间（秒），小于此录制时间的视频文件将被忽略，默认不启用
      # 和最小大小配合使用时，只要有一个满足就会被忽略
      # 此参数推荐不设置，因为虚拟下载中视频长度是由文件创建时间和修改时间计算得到的
      # 在部分情况下中这两个时间相等，会导致计算得到的视频长度为0
      min_video_duration: ~
    # 额外信息，暂时没用
    extra_info: ~

# 渲染器核心参数
render_kernel_args:
  # 指定同时执行的渲染任务数，默认1
  # 一般情况下此值不应该超过5（最好是不修改）
  nrenders: 1

# 渲染器默认参数
render_args:
  # 弹幕渲染
  dmrender:
    # 渲染输出文件夹，默认为在录制输出文件夹后面加上“弹幕版”
    output_dir: ~
    # 渲染文件名称，默认在录制文件后面加上“弹幕版”
    output_name: ~
    # 生成的视频文件格式，默认mp4
    format: mp4
    # 硬件解码参数，默认由FFmpeg自动判断，如果出现问题可以设为空
    hwaccel_args: ~
    #['-hwaccel', 'qsv','-hwaccel_output_format', 'qsv']
    # 视频编码器，NVIDIA设置为h264_nvenc，AMD设置为h264_amf，Apple用户设置为h264_videotoolbox，CPU设置为libx264
    vencoder: av1_qsv
    # 视频编码器参数，默认恒定码率15Mbps
    vencoder_args: [
      '-preset', 'veryslow',
      '-global_quality:v', '29',
      #'-extbrc', '1',
      #'-look_ahead_depth', '40',
      '-tag:v', 'av01',
      '-movflags', '+faststart'
    ]
    # 音频编码器
    aencoder: libopus
    # 音频编码器参数，默认恒定码率320Kbps
    aencoder_args: [
      '-b:a', '64k',
      '-vbr:a', 'on',
      #'-compression_level:a', '10',
      '-frame_duration:a', '60',
      #'-application:a', 'audio',
    ]
    # 输出重缩放，会把输出重缩放到指定分辨率，可以设置为'WxH'直接指定输出分辨率，例如'3840x2160'（4K）
    # 也可以指定为当前视频的大小倍数，例如'1.5'，这样1080P视频将会被放大到2880x1620（这个也符合了B站的4K视频标准）
    output_resize: ~
    # GOP（关键帧间隔） = 源视频帧率 x gop_multiplier
    #   8    → 每 8 秒一个关键帧（1080P60 就是 -g 480，1080P30 就是 -g 240）
    #   10   → 每 10 秒一个关键帧
    #   ~    → 不干预，使用编码器默认值（关闭此功能）
    # 注意：如果你自己在 vencoder_args 里写了 -g，这里会自动跳过，以你的为准
    gop_multiplier: 8
    # 当无法探测到源视频帧率时，GOP 按这个帧率兜底计算
    gop_default_fps: 30
    # ══════════════════════════════════════════════════════════════════
    # 高质量大文件「跳过上传」规则
    #   用途：横屏、高码率、高帧率的录播体积太大，不值得上传（占带宽/占网盘空间），
    #         命中规则就整组跳过上传（B站和网盘都不传）。
    #
    #   ⚠️ 跳过上传 **不影响本地文件**：
    #         原视频照常按 clean_args 删除，弹幕版按 clean_args 留存（不上传也不删）。
    #
    #   三个条件可任意组合，skip_min_matches 决定"命中几个才算跳过"：
    #     skip_min_matches: 2  →  3 个条件里满足任意 2 个就跳过
    #     skip_min_matches: 3  →  必须三个全满足
    #     skip_min_matches: 1  →  满足任意一个就跳过
    #
    #   ⚠️ 只在 common_event_args.auto_upload: True 时才起作用（上传都没开就不会触发）
    #   ⚠️ 数据取不到时一律「不跳过」（宁可多传也不误跳过），日志里会说明原因
    # ══════════════════════════════════════════════════════════════════
    skip_upload_rule:
      # 总开关
      enabled: True
      # 条件1：是横屏（宽 > 高）
      skip_landscape: True
      # 横屏「必选」：打开后，竖屏视频无论码率/帧率多高都**不会**被跳过。
      #   True  + skip_min_matches: 1  →  横屏 且 (码率>=2500 或 帧率>=40) 才跳过
      #   False + skip_min_matches: 2  →  纯数值判断，竖屏高码率高帧率也会被跳过
      skip_require_landscape: True
      # 条件2：码率 >= 这个值（单位 kbps）
      skip_bitrate_kbps: 2500
      # 条件3：帧率 >= 这个值
      skip_fps: 40
      # 命中几个条件就跳过
      #   配合 skip_require_landscape: True 时这里写 1
      #   （横屏已经必选，码率/帧率再命中任意 1 个就跳过）
      skip_min_matches: 1
    # 高级渲染参数
    # 请确保你明白这些参数的含义后再修改
    advanced_render_args:
      # 直接定义video filter，这里的{DANMAKU}代表弹幕文件路径
      # 注意设置filter_complex之后将会禁用fps等其他有关filter的选项
      filter_complex: subtitles=filename='{DANMAKU}'
    # XML 弹幕转换参数（仅当弹幕文件是 .xml 时需要；本程序自己录制的弹幕是 .ass，不走这里）
    # 弹幕转换由 dmconvert 库完成(https://github.com/timerring/DanmakuConvert)，需要 `pip install dmconvert`
    # 下面的默认值与上方弹幕录制参数（dm_font/dm_fontsize/dm_opacity 等）保持一致
    dmconvert:
      # 弹幕字体名称
      font_name: Microsoft YaHei
      # 弹幕字体大小（绝对像素值；不随分辨率自适应，需要其他分辨率下的等效字号请自行换算）
      font_size: 36
      # SuperChat/礼物弹幕的字体大小（绝对像素值）
      sc_font_size: 36
      # 弹幕渲染分辨率，留空(~)则由渲染器从视频自动探测（推荐）
      # 也可以显式指定，例如 1920x1080 就写成 resolution_x: 1920, resolution_y: 1080
      resolution_x: ~
      resolution_y: ~
      # 弹幕显示区域占屏幕高度的比例，0.00-1.00（对应弹幕录制参数 dmrate）
      displayarea: 0.4
      # 滚动弹幕显示时长（秒）（对应弹幕录制参数 dmduration）
      roll_time: 16.0
      # 固定弹幕（顶部/底部）显示时长（秒）
      fix_time: 5.0
      # 弹幕不透明度，0.0-1.0（对应弹幕录制参数 opacity）
      opacity: 0.8
      # 是否加粗，0或1
      bold: 0
      # 弹幕描边宽度（对应弹幕录制参数 outlinesize）
      outline: 1.0
      # 弹幕阴影宽度
      shadow: 0.0  # 原视频转码
  transcode:
    # 渲染输出文件夹，默认为在录制输出文件夹后面加上“转码后”
    output_dir: ~
    # 渲染文件名称，默认在录制文件后面加上“转码后”
    output_name: ~
    # 生成的视频文件格式，默认mp4
    format: mp4
    # 硬件解码参数，默认由FFmpeg自动判断，如果出现问题可以设为空
    hwaccel_args: [-hwaccel, auto]
    # 视频编码器，NVIDIA设置为h264_nvenc，AMD设置为h264_amf，Apple用户设置为h264_videotoolbox，CPU设置为libx264
    vencoder: h264_nvenc
    # 视频编码器参数，默认恒定码率15Mbps
    vencoder_args: [-b:v, 15M]
    # 音频编码器
    aencoder: aac
    # 音频编码器参数，默认恒定码率320Kbps
    aencoder_args: [-b:a, 320K]
    # 输出重缩放，会把输出重缩放到指定分辨率，可以设置为'WxH'直接指定输出分辨率，例如'3840x2160'（4K）
    # 也可以指定为当前视频的大小倍数，例如'1.5'，这样1080P视频将会被放大到2880x1620（这个也符合了B站的4K视频标准）
    output_resize: 1.5
    # 高级渲染参数
    # 请确保你明白这些参数的含义后再修改
    advanced_render_args: ~
  # 自定义ffmpeg调用（暂不可用）
  rawffmpeg:
    # 输出文件类型，可选src_video或者dm_video
    output_dtype: ~
    # 命令行参数，可以使用关键字替换
    # 为保证安全调用，请使用参数列表的形式，例如：['{FFMPEG}', '-i', '{SRC_VIDEO}', '-c', 'copy', '{OUTPUT}']
    cmds: ~

# 上传器核心参数
uploader_kernel_args:
  # 指定同时执行的上传任务数，默认1
  nuploaders: 1

# 上传器默认参数
# 上传器默认参数
#   ⚠️ 魔改版：B站上传段（bilibili）已删除 —— 你暂时不用 B站。
#      任务里如果还写了 target: bilibili，会被自动跳过并打 warning，不会报错中断。
#      想恢复 B站上传：把原来的 bilibili 段从官方 default.yml 或 git 历史里拷回来即可。
upload_args:
  # ══════════════════════════════════════════════════════════════════
  # 上传到网盘（rclone）
  #   用法：rclone 必须已安装且在 PATH 中，并且已经配置好 remote
  #   ⚠️ remote 名是 cd2（百度网盘 WebDAV），**不是** 123pan
  #      cd2:    = 百度网盘（12TB，本机已在用，DMR录播 目录已存在）
  #      123pan: = 另一个 123云盘的 remote，别搞混
  #
  #   ★ 怎么让视频同时传 B 站 + 网盘 ★
  #   （B站段已删除；想恢复就把 bilibili 段加回 upload_args）
  #   在每个任务 yml 里加一段 upload_args，key 写 'bilibili+rclone' 即可：
  #
  #     upload_args:
  #       dm_video+bilibili+rclone:
  #         - target: bilibili      # ← 这个 target 决定继承下面哪一套默认参数
  #           engine: biliuprs
  #         - target: rclone
  #           engine: subprocess
  #           command: ['rclone','copy','{PATH}','cd2:百度网盘/DMR录播/{TASKNAME}','--retries','5']
  #
  #   key 的写法规则：用 '+' 分隔，其中**必须包含一个视频类型**：
  #       src_video = 原视频 .mkv      dm_video = 弹幕版 .mp4
  #   其余部分只是匹配用的标签，随便写（比如 bilibili+rclone）。
  #
  #   多份上传是**并行**的，谁都不会等谁。
  #
  #   ★ 魔改版：清理已经和上传**完全解耦** ★
  #     原视频在弹幕版渲染完成的瞬间就按 clean_args 删除，不等上传结果。
  #     上传成功与否只影响「失败上传」列表，不会让原视频堆积。
  # ══════════════════════════════════════════════════════════════════
  rclone:
    # 上传引擎，网盘只能用子进程调用
    engine: subprocess
    # 实时上传：每录制一个分段就调用一次上传命令
    # 自定义上传**必须启用**，否则录完的分段不会被提交
    realtime: True
    # 重试次数，如果上传遇到错误将会重试，设置为0表示不重试
    # 注意：重试会整个视频重传，并且阻塞后面视频的上传，不应该设置太大    retry: 3
    # 上传超时时间（秒），超过此时间会被强制终止，0表示不限制
    timeout: 0
    # 上传的视频最短长度，小于此长度的视频会被自动过滤，默认120s
    min_length: 120
    # 上传命令行参数，可以使用关键字替换
    # 为保证安全调用，请使用参数列表的形式，例如：['python', 'upload.py', '{PATH}']
    command: ~


# 清理器默认参数clean_args:
  move:
    dest: ~              # move/copy 的目标目录（用时必须在具体规则里指定）
    delay: 86400         # 默认延迟 24 小时
    w_srcfile: False     # 清理 dm_video 时是否连带删 src_video+弹幕（默认否）
    w_srcpre: True       # 清理 src_video 时是否连带删"转码前"文件（默认是）
  copy:
    dest: ~
    delay: 0
    w_srcfile: False
    w_srcpre: True
  delete:
    delay: 172800        # delete 出厂默认延迟 48 小时（②里已覆盖为 0）
    w_srcfile: False
    w_srcpre: True
  custom:
    command: ~           # custom 必须写命令数组，如 ['powershell','-File','xx.ps1','{path}']
    wait: True           # 是否等命令跑完（内置 move/copy/delete 恒为同步）
    delay: 0
    w_srcfile: False
    w_srcpre: True

# ── ② 全局默认清理规则 ─────────────────────────────────────────────
#     任务 yml 没写 clean_args 时生效（你的全部任务都是这种情况）
clean_args_task_default:

  # ▼▼▼ 规则 1：原视频 → 渲染完成后立即删除 ▼▼▼
  #     .ass 弹幕会被 Cleaner 自动连带删除（读文件的 dm_file_id 属性）
  #     没开转码时 w_srcpre 无可删对象，自动跳过
  src_video:
    method: delete
    delay: 0             # 0=立即。想留后悔期改 3600（1小时）或 86400（1天）
    w_srcpre: True

  # ▼▼▼ 规则 2：弹幕版 → 渲染完成后【本地保留】▼▼▼
  #     ⚠️ 2026-10-05 改动：上传已经从这个清理规则里拿掉了！
  #        上传现在由 uploader 负责（见下面的 upload_args_task_default），
  #        清理和上传**完全解耦**：这里只决定本地文件怎么处理。
  #     这里配 delete 才会删本地弹幕版；当前故意不配，让它留在本地做备份。
  #     想改成"上传成功后删本地"就配成 delete + delay，但那又会和上传耦合，
  #     不推荐（上传失败会导致文件堆积）。
  # dm_video:
  #   method: delete
  #   delay: 0

  # ▲▲▲ 备选方案（想换策略时：注释掉上面对应规则，取消这里的注释）▲▲▲
  #
  # ❏ 备选 B：弹幕版复制到 RaiDrive 挂载盘（不装 rclone 用这个，稳定性差一档）
  #           Z: 换成实际挂载盘符；copy 不删本地文件
  # dm_video:
  #   - method: copy
  #     dest: 'Z:/DMR录播/{taskname}'
  #     delay: 0
  #
  # ❏ 备选 C：用 clean 的 custom 调外部脚本（注意：上传已经在 uploader 里做了，
  #     这里通常不再需要）
  #         param([string]$p)
  #         rclone copy $p "cd2:百度网盘/DMR录播" --retries 5
  #         if ($LASTEXITCODE -eq 0) { Remove-Item -LiteralPath $p }
  # dm_video:
  #   - method: custom
  #     delay: 0
  #     wait: True
  #     command: ['powershell','-ExecutionPolicy','Bypass','-File','D:/DMR/upload_dm.ps1','{path}']
  #
  # ❏ 备选 D：原视频先进回收站，7 天后彻底删（怕误删用这个）
  # src_video:
  #   - method: move
  #     dest: '*TRASHBIN*'
  #     delay: 0
  #   - method: delete
  #     delay: 604800

webservice_kernel_args:
  web_api: True
  # 服务端口
  port: 5000
  # 绑定地址
  host: '0.0.0.0'
  # 是否强制登录
  force_login: True
  # 管理员用户名
  username: 'admin'
  # 管理员密码
  password: 'admin'

# 状态持久化参数
# 把"录制会话 / 产物 / 上传组"的状态存入 SQLite，使程序重启后能继续处理未完成的
# 工作（未渲染/未上传的视频、录到一半的产物）
state:
  # 状态库路径。默认 logs/dmr_state.db
  # 特别注意：状态库是"单一全局库"，以任务名（taskname）区分任务。
  # 如果删除了它，之前所有未完成的进度都会丢失（等同于重新开始）。
  db_path: logs/dmr_state.db

# 启动对账参数（可选，不填则使用下列默认值）
# 程序启动时会比对状态库与磁盘，并按这里的策略处置"未完成"的产物
recovery:
  # 录到一半的产物如何处置
  # ask(默认)：只标记为 interrupted，等你自己决定（不会动文件）
  # keep     ：校验通过则转正为正常产物（之后可正常渲染/上传）
  # discard  ：直接删除（等同于"从 0 开始"）
  on_interrupted_file: ask
  # 重启后是否自动继续处理"已录制 / 已渲染但未完成"的产物（重新派发渲染与上传）
  # true(默认)：把上次没上传、没渲染完的分段接着处理，避免它们永远停在库里
  # false     ：只对账不重跑，适合想先人工核对再上传的场景
  # 注意：已上传(uploaded)或已清理(cleaned)的产物永不重跑，不会重复投稿
  resume: true
  # 不满足恢复条件的产物（大小不足、文件已不存在）如何处置
  # skip(默认)：标记为 skipped 并停止重试，**不删除文件**（文件留在磁盘上）
  # discard   ：同上并删除文件
  # ask       ：保持原状态，每次重启都会再试一遍（日志会有重复告警）
  on_unusable_file: skip
  # .part 转正所需的最低完整度（低于此值一律不转正）
  min_valid_duration: 60      # 秒
  # 「录到一半的文件是否可信」的**大小阈值**（MB，默认 30）
  # 这一项同时用于两处必须一致的判定：
  #   1. 启动对账校验中断产物（.part / 引擎直写最终名）够不够大
  #   2. 重启恢复时判定产物值不值得继续处理
  # 两者都在回答同一个问题——"是否已录到实质内容"，因此共用此配置。
  # 判定**不依赖 ffprobe**：文件名以 [正在录制] 开头 + 大小达标即视为正常。
  min_valid_size_mb: 30
  # 非终态产物超过此时长仍未更新则视为异常并抛弃（秒）
  # 正常一场直播不会超过 7 天，因此默认 604800（7 天）
  stale_after: 604800
  # 上传器实例空闲多久后释放（秒）。远端稿件 bvid 已存入状态库，释放不影响续传
  idle_release: 300
  # 上传组过期时间（秒），留空(~)表示永不过期
  # 用于"按月分视频"等需要长期复用同一个稿件的场景
  upload_group_expires: ~

